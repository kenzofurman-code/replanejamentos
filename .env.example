# ===================================================
# CONFIGURAÇÃO DE AMBIENTE - REPLANEJAMENTO DE OBRAS
# ===================================================

# Para execução local (SQLite zero-config):
DATABASE_URL=sqlite:///./replanejamento.db

# Para conexão na VPS com PostgreSQL:
# POSTGRES_USER=piemonte_user
# POSTGRES_PASSWORD=sua_senha_segura
# POSTGRES_DB=replanejamento_db
# DATABASE_URL=postgresql+psycopg://piemonte_user:sua_senha_segura@localhost:5432/replanejamento_db

# Ciclo padrão de medição (ex: dia 21 ao 20 para o PLATEA)
DEFAULT_CYCLE_START_DAY=21
DEFAULT_CYCLE_END_DAY=20

DEBUG=True
PORT=8000
